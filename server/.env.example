# ---------------------------------------------------------------
# AI Intake Pipeline - Backend Environment Configuration
# ---------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
# Never commit `.env` to version control. Add it to .gitignore.
# Provider credentials are read only from the environment.
# No API keys or secrets belong in source files.

# Server
PORT=3000
NODE_ENV=development

# -----------------------------------------------------------------
# Provider credentials (required)
# -----------------------------------------------------------------
# Provider id. Supported: "openrouter" (default) | "openai"
INTAKE_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional OpenRouter attribution headers.
# OPENROUTER_APP_URL is sent as HTTP-Referer; OPENROUTER_APP_NAME as X-Title.
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_NAME=Axlero-AI-Intake

# Optional OpenAI provider credentials (only when INTAKE_LLM_PROVIDER=openai)
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_BASE_URL=
# OPENAI_ORGANIZATION=

# -----------------------------------------------------------------
# Routing model (fast, low-latency classification)
# Free NVIDIA Nemotron model via OpenRouter.
# -----------------------------------------------------------------
INTAKE_ROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# Backwards-compatible alias: INTAKE_ROUTING_MODEL
INTAKE_ROUTING_TEMPERATURE=0
INTAKE_ROUTING_TIMEOUT_MS=15000
INTAKE_ROUTING_MAX_RETRIES=2
INTAKE_ROUTING_BACKOFF_INITIAL_MS=500
INTAKE_ROUTING_BACKOFF_MAX_MS=3000
INTAKE_ROUTING_BACKOFF_FACTOR=2
INTAKE_ROUTING_BACKOFF_JITTER=0.1

# -----------------------------------------------------------------
# Extraction model (higher-reasoning structured extraction)
# Free NVIDIA Nemotron model via OpenRouter.
# -----------------------------------------------------------------
INTAKE_EXTRACTION_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
INTAKE_EXTRACTION_TEMPERATURE=0
INTAKE_EXTRACTION_TIMEOUT_MS=45000
INTAKE_EXTRACTION_MAX_RETRIES=2
INTAKE_EXTRACTION_BACKOFF_INITIAL_MS=1000
INTAKE_EXTRACTION_BACKOFF_MAX_MS=10000
INTAKE_EXTRACTION_BACKOFF_FACTOR=2
INTAKE_EXTRACTION_BACKOFF_JITTER=0.2

# -----------------------------------------------------------------
# Free-model fallback (used on HTTP 429 / transient upstream errors)
# -----------------------------------------------------------------
# A different free Nemotron model keeps the pipeline serving traffic when
# the primary :free endpoint is rate-limited or briefly unavailable.
INTAKE_FALLBACK_MODEL=nvidia/nemotron-3.5-super-vl:free
# Optional role-specific overrides:
# INTAKE_ROUTING_FALLBACK_MODEL=nvidia/nemotron-3.5-super-vl:free
# INTAKE_EXTRACTION_FALLBACK_MODEL=nvidia/nemotron-3.5-super-vl:free

# -----------------------------------------------------------------
# Global fallbacks (used when a role-specific value is not set)
# -----------------------------------------------------------------
# LLM_TIMEOUT_MS=20000
# LLM_MAX_RETRIES=3
# LLM_BACKOFF_INITIAL_MS=500
# LLM_BACKOFF_MAX_MS=8000
# LLM_BACKOFF_FACTOR=2
# LLM_BACKOFF_JITTER=0.2

# -----------------------------------------------------------------
# Extraction policy
# -----------------------------------------------------------------
# Confidence below this value forces requires_review=true.
INTAKE_REVIEW_CONFIDENCE_THRESHOLD=0.75
# Maximum accepted characters for POST /api/intake/extract.
INTAKE_MAX_INPUT_CHARS=20000
