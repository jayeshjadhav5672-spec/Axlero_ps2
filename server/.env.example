# ---------------------------------------------------------------
# AI Intake Pipeline - Backend Environment Configuration
# ---------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
# Never commit `.env` to version control. Add it to .gitignore.

# Server
PORT=3000
NODE_ENV=development

# OpenAI / LangChain provider credentials (required)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Model selection
# Fast, low-cost model for routing / classification
INTAKE_ROUTING_MODEL=gpt-4o-mini
# Higher-reasoning model for structured field extraction
INTAKE_EXTRACTION_MODEL=gpt-4o

# Provider resilience
LLM_TIMEOUT_MS=12000
LLM_MAX_RETRIES=3
